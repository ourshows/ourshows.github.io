rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection - profiles, watchlists, watched history
    match /users/{userId} {
      allow read: if true;
      
      allow create, update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
      
      match /watchlist/{movieId} {
        allow read: if true;
        allow write: if isSignedIn() && isOwner(userId);
      }
      
      match /watched/{movieId} {
        allow read: if true;
        allow write: if isSignedIn() && isOwner(userId);
      }
      
      match /stats/{statId} {
        allow read: if true;
        allow write: if isSignedIn() && isOwner(userId);
      }
    }
    
    // Clubs (New Feature)
    match /clubs/{clubId} {
      allow read: if true;
      
      // Allow creating clubs if authenticated
      allow create: if isSignedIn() && 
                      request.resource.data.createdBy == request.auth.uid &&
                      request.resource.data.name != null;
      
      // Allow updates (e.g. for members joining)
      // Refined to ensure only signed-in users can update
      allow update: if isSignedIn();
      
      // Only owner can delete
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Posts/Social Feed
    match /posts/{postId} {
      allow read: if true;
      
      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.timestamp == request.time;
      
      allow update, delete: if isSignedIn() && 
                               resource.data.userId == request.auth.uid;
      
      match /comments/{commentId} {
        allow read: if true;
        
        allow create: if isSignedIn() && 
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.timestamp == request.time;
        
        allow update, delete: if isSignedIn() && 
                                 resource.data.userId == request.auth.uid;
      }
    }
    
    // Chat messages (community chat)
    match /messages/{messageId} {
      allow read: if true;
      
      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.username != null &&
                      request.resource.data.timestamp == request.time;
      
      allow delete: if isSignedIn() && 
                      resource.data.userId == request.auth.uid;
      
      allow update: if false; 
    }
    
    // Movie/Series reviews
    match /reviews/{reviewId} {
      allow read: if true;
      
      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.timestamp == request.time &&
                      request.resource.data.rating >= 1 &&
                      request.resource.data.rating <= 5 &&
                      request.resource.data.movieId != null;
      
      allow update, delete: if isSignedIn() && 
                               resource.data.userId == request.auth.uid;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}